rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{collection}/{id} {
      allow read: if true;
      allow create, update: if request.auth != null;
      // 삭제는 관리자만 (아래 관리자UID를 본인 UID로 바꾸세요)
      allow delete: if request.auth != null && request.auth.uid == '관리자UID';
    }
  }
}
